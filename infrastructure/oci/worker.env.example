# Install as /etc/nutrilens/worker.env with mode 0600.
# Generate AI_WORKER_TOKEN locally on the OCI VM; never commit or paste it.
AI_WORKER_TOKEN=replace_with_a_random_server_to_server_secret
R3_DEVICE=cpu
R3_ALLOW_MODEL_DOWNLOADS=false
R3_MODEL_CACHE=/app/.model-cache/r3
AI_WORKER_QUEUE_TIMEOUT_SECONDS=3
AI_WORKER_MAX_CONCURRENT_SCANS=1
R3_SCAN_TIMEOUT_SECONDS=120
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
