[Unit]
Description=NutriLens X outbound-only Cloudflare Tunnel
After=network-online.target nutrilens-ai-worker.service
Wants=network-online.target nutrilens-ai-worker.service

[Service]
Type=simple
User=cloudflared
Group=cloudflared
ExecStart=/usr/local/bin/cloudflared --no-autoupdate --config /etc/nutrilens/cloudflared.yml tunnel run
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/nutrilens

[Install]
WantedBy=multi-user.target
