# Paths may be absolute or relative to the repository root.
NUTRILENS_MODEL_PATH=data/processed/health_score_model.joblib
NUTRILENS_FRONTEND_DIR=frontend

# Upload/OCR settings
NUTRILENS_MAX_UPLOAD_BYTES=8388608
NUTRILENS_MAX_IMAGE_PIXELS=25000000
NUTRILENS_OCR_LANGUAGE=eng
NUTRILENS_OCR_ENGINE=tesseract
# NUTRILENS_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Comma-separated development origins. Same-origin FastAPI UI needs no CORS.
NUTRILENS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
NUTRILENS_LOG_LEVEL=INFO

# Optional dynamic M5 model attribution. Install backend/requirements-shap.txt
# and review runtime/memory measurements before explicitly enabling it.
NUTRILENS_M5_SHAP_ENABLED=false
NUTRILENS_M5_SHAP_TOP_FEATURES=8
NUTRILENS_M5_SHAP_MAX_FEATURES=3000
NUTRILENS_M5_SHAP_MAX_NONZERO_FEATURES=512
NUTRILENS_M5_SHAP_MAX_TREES=250
NUTRILENS_M5_SHAP_MAX_RUNTIME_MS=2000
NUTRILENS_M5_SHAP_ADDITIVITY_TOLERANCE=0.000001

# Authentication / user database
# SQLite is used automatically at data/nutrilens.db unless overridden.
# NUTRILENS_DATABASE_URL=sqlite:///data/nutrilens.db
NUTRILENS_JWT_SECRET_KEY=replace-with-a-long-random-secret
NUTRILENS_JWT_EXPIRE_MINUTES=60
