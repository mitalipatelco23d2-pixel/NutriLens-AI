# Application
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_INTERNAL_URL=http://localhost:8000
PUBLIC_WEBSITE_URL=
PUBLIC_API_URL=
ANDROID_APP_LINK=
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_SUPPORT_EMAIL=
# Owner/legal approval gate before Razorpay Live onboarding or real charging.
LEGAL_POLICIES_APPROVED=false

# Development-only database credentials. Replace outside local development.
POSTGRES_DB=nutrilens
POSTGRES_USER=nutrilens
POSTGRES_PASSWORD=
POSTGRES_URL=postgresql://nutrilens:replace_with_generated_local_secret@postgres:5432/nutrilens
PERSISTENCE_BACKEND=memory
AUTO_MIGRATE=false

MONGO_INITDB_ROOT_USERNAME=nutrilens
MONGO_INITDB_ROOT_PASSWORD=
MONGODB_URL=mongodb://nutrilens:replace_with_generated_local_secret@mongodb:27017/admin

NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_URL=bolt://neo4j:7687

REDIS_PASSWORD=
REDIS_URL=redis://:replace_with_generated_local_secret@redis:6379/0
# Use redis outside development; public mode rejects the in-memory limiter.
RATE_LIMIT_BACKEND=memory

# Placeholder only. Generate a strong secret before any non-local deployment.
JWT_SECRET=replace_before_non_local_use_at_least_32_bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
GOOGLE_CLIENT_ID=
PUBLIC_WEB_URL=http://localhost:3000

# Email/password authentication. Keep disabled until a transactional sender is configured.
EMAIL_AUTH_ENABLED=false
EMAIL_PROVIDER=none
EMAIL_FROM=
RESEND_API_KEY=
EMAIL_VERIFICATION_MINUTES=30
PASSWORD_RESET_MINUTES=20
AUTH_MAX_PASSWORD_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
PHONE_AUTH_ENABLED=false
PHONE_OTP_PROVIDER=none

# Razorpay Test Mode only. Never commit values or enable live charging automatically.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PLUS_MONTHLY=
RAZORPAY_PLAN_PLUS_ANNUAL=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_ANNUAL=
RAZORPAY_PLAN_MAX_MONTHLY=
RAZORPAY_PLAN_MAX_ANNUAL=

# R3 Food Understanding (CPU-first; optional pretrained model downloads are opt-in)
R3_MAX_UPLOAD_BYTES=10485760
R3_MIN_IMAGE_DIMENSION=64
R3_MAX_IMAGE_DIMENSION=12000
R3_SCAN_TIMEOUT_SECONDS=180
R3_DEVICE=auto
R3_ALLOW_MODEL_DOWNLOADS=false
R3_MODEL_CACHE=.model-cache/r3
R3_BLUR_THRESHOLD=80
R3_DARK_THRESHOLD=45
R3_BRIGHT_THRESHOLD=225
R3_CONTRAST_THRESHOLD=28
R3_OCR_MIN_CONFIDENCE=0.55
R3_OCR_MIN_CHARACTERS=4
R3_OCR_MAX_IMAGE_SIDE=1800
R3_NUTRITION_YOLO_MODEL=.model-cache/r3/custom/nutrition-table-yolo11n-v1.pt
R3_NUTRITION_YOLO_CONFIDENCE=0.30
R3_NUTRITION_YOLO_IMAGE_SIZE=640
R3_NUTRITION_YOLO_NMS_IOU=0.50
R3_NUTRITION_YOLO_MAX_DETECTIONS=3
R3_TROCR_ENABLED=false

# Private AI generation and worker routing. Never expose either token to the browser.
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_MODEL=
LLM_SERVICE_TOKEN=
LLM_TIMEOUT_SECONDS=20
# Optional semantic retrieval. Keep disabled on the web API and 2-GiB vision worker until a
# separately sized runtime has the local model plus checksum-bound governed index.
SEMANTIC_RAG_ENABLED=false
SEMANTIC_RAG_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_RAG_MODEL_PATH=.model-cache/rag/all-MiniLM-L6-v2
SEMANTIC_RAG_INDEX_DIR=databases/faiss/knowledge
SEMANTIC_RAG_MIN_SCORE=0.35
AI_WORKER_PROVIDER=none
AI_WORKER_URL=
AI_WORKER_TOKEN=
# Capacity-only retries are safe because the worker rejects before inference starts.
AI_WORKER_CAPACITY_RETRY_ATTEMPTS=10
AI_WORKER_CAPACITY_RETRY_BASE_SECONDS=2
# Set true only after a documented successful public inference proof.
AI_RUNTIME_PUBLIC_VALIDATED=false
# Server-controlled Android rollout. Valid values: disabled, shadow, preferred.
# Keep shadow until real-device quality, security, and fallback gates pass.
ANDROID_CLIENT_INFERENCE_MODE=shadow
ANDROID_CLIENT_MIN_POSITIONED_LINES=6
ANDROID_CLIENT_MIN_POSITIONED_RATIO=0.65
ANDROID_CLIENT_MIN_NUTRITION_ROWS=4
ANDROID_CLIENT_MIN_MAJOR_NUTRIENTS=3
ANDROID_CLIENT_MIN_NUTRITION_CONFIDENCE=0.58
