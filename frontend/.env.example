# Leave empty when using the Vite development proxy or same-origin production hosting.
VITE_API_BASE_URL=

# Local development expects true. Set false only when analysis is intentionally unavailable.
VITE_ANALYSIS_ENABLED=true

# Client-side preflight only. The backend remains authoritative (default: 8 MiB).
VITE_MAX_UPLOAD_BYTES=8388608
