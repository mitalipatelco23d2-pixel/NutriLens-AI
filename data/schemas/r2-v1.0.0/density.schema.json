{
  "$defs": {
    "Lineage": {
      "additionalProperties": false,
      "properties": {
        "input_checksum": {
          "title": "Input Checksum",
          "type": "string"
        },
        "license_status": {
          "title": "License Status",
          "type": "string"
        },
        "pipeline_version": {
          "default": "0.1.0",
          "title": "Pipeline Version",
          "type": "string"
        },
        "processing_timestamp": {
          "format": "date-time",
          "title": "Processing Timestamp",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_dataset": {
          "title": "Source Dataset",
          "type": "string"
        },
        "source_record_id": {
          "title": "Source Record Id",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "source_version": {
          "title": "Source Version",
          "type": "string"
        }
      },
      "required": [
        "source_dataset",
        "source_record_id",
        "source_version",
        "input_checksum",
        "processing_timestamp",
        "license_status"
      ],
      "title": "Lineage",
      "type": "object"
    }
  },
  "$id": "https://nutrilens.local/schemas/1.0.0/density.schema.json",
  "additionalProperties": false,
  "properties": {
    "bibliography_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bibliography Id"
    },
    "density": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Density"
    },
    "density_unit": {
      "anyOf": [
        {
          "const": "g/mL",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Density Unit"
    },
    "food_id": {
      "title": "Food Id",
      "type": "string"
    },
    "food_name": {
      "title": "Food Name",
      "type": "string"
    },
    "lineage": {
      "$ref": "#/$defs/Lineage"
    },
    "quality_notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quality Notes"
    },
    "record_status": {
      "enum": [
        "MEASUREMENT",
        "PARTIAL_REFERENCE",
        "CATEGORY_HEADER"
      ],
      "title": "Record Status",
      "type": "string"
    },
    "source_row": {
      "title": "Source Row",
      "type": "integer"
    },
    "specific_gravity_original": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Specific Gravity Original"
    },
    "temperature_or_condition": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Temperature Or Condition"
    }
  },
  "required": [
    "food_id",
    "food_name",
    "source_row",
    "record_status",
    "lineage"
  ],
  "title": "DensityRecord",
  "type": "object",
  "x-nutrilens-schema-version": "1.0.0"
}
