    "barcode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Barcode"
    },
    "barcode_valid": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Barcode Valid"
    },
    "brand": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Brand"
    },
    "brand_match_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Brand Match Key"
    },
    "brand_original": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Brand Original"
    },
    "category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Category"
    },
    "country": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Country"
    },
    "data_quality_score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Data Quality Score",
      "type": "number"
    },
    "image_available": {
      "title": "Image Available",
      "type": "boolean"
    },
    "ingredient_data_available": {
      "title": "Ingredient Data Available",
      "type": "boolean"
    },
    "ingredients_normalized_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ingredients Normalized Text"
    },
    "ingredients_original": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ingredients Original"
    },
    "languages": {
      "items": {
        "type": "string"
      },
      "title": "Languages",
      "type": "array"
    },
    "lineage": {
      "$ref": "#/$defs/Lineage"
    },
    "nova_group": {
      "anyOf": [
        {
          "maximum": 4,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Nova Group"
    },
    "nutrition_available": {
      "title": "Nutrition Available",
      "type": "boolean"
    },
    "product_id": {
      "title": "Product Id",
      "type": "string"
    },
    "product_name": {
      "title": "Product Name",
      "type": "string"
    },
    "product_name_match_key": {
      "title": "Product Name Match Key",
      "type": "string"
    },
    "product_name_original": {
      "title": "Product Name Original",
      "type": "string"
    },
    "quantity": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quantity"
    },
    "quantity_unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quantity Unit"
    },
    "record_status": {
      "title": "Record Status",
      "type": "string"
    },
    "serving_size": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Serving Size"
    },
    "serving_unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Serving Unit"
    },
    "source_product_id": {
      "title": "Source Product Id",
      "type": "string"
    },
    "source_timestamp": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Timestamp"
    },
    "subcategory": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subcategory"
    }
  },
  "required": [
    "product_id",
    "source_product_id",
    "product_name_original",
    "product_name",
    "product_name_match_key",
    "nutrition_available",
    "ingredient_data_available",
    "image_available",
    "data_quality_score",
    "record_status",
    "lineage"
  ],
  "title": "ProductRecord",
  "type": "object",
  "x-nutrilens-schema-version": "1.0.0"
}
